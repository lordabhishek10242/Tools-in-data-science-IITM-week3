# Public origin plus mounted route prefix, with trailing slash.
PUBLIC_BASE_URL=https://your-host.example/a2a/
A2A_BASE_PATH=/a2a
DATABASE_PATH=/data/invoice-agent.sqlite3

# OpenAI-compatible chat completions endpoint. Leave empty to use local Ollama.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# For local AI, e.g. http://127.0.0.1:11434/v1
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:14b

